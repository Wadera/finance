{
  "name": "skyday-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-user personal & shared household finance, sinking-fund budgeting, and wealth tracking platform for SKYDAY",
  "scripts": {
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:api",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "fastify": "^5.2.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/d3-array": "^3.2.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
