# Skyday Finance & Budget — Environment Template
PORT=3020
HOST=0.0.0.0
DATA_DIR=/data
PUBLIC_BASE_URL=https://finance.skyday.eu

# Authentication mode: "authentik" (production fail-closed SSO) | "dev" (local development switcher)
AUTH_MODE=authentik
SESSION_SECRET=replace-with-64-hex-secret-at-deploy

# Native Authentik OIDC (Authorization Code + PKCE S256)
AUTHENTIK_PUBLIC_URL=https://auth.skyday.eu
AUTHENTIK_INTERNAL_URL=http://authentik-server-1:9000
AUTHENTIK_APP_SLUG=skyday-finance
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Optional Trusted Reverse Proxy Prefixes for ForwardAuth headers (X-authentik-*)
TRUSTED_PROXY_PREFIXES=10.100.12.,10.100.2.,172.,127.0.0.1,::ffff:10.100.
